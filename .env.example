# Point the labs at a Quantova gateway. Without it the labs use the official
# testnet gateway. Set QUANTOVA_OFFLINE to 1 to skip the labs that need a node,
# so npm test runs only the self verifying checks such as the SHA3 256 known
# answer tests. The labs expect the chain Q-test-net-01 unless QUANTOVA_CHAIN_ID
# names another.

QUANTOVA_GATEWAY_URL=https://rpc-testnet.quantova.org

QUANTOVA_CHAIN_ID=Q-test-net-01
